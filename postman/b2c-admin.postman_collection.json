            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"{{payment_method}}\",\n  \"card\": {\n    \"number\": \"4111111111111111\",\n    \"expire\": \"1230\"\n  },\n  \"save\": false\n}"
            },
            "description": "method — a code from site-config payment_methods, required (default here: {{payment_method}}). Either card_id (a saved card) or card: {number, expire} — exactly one. save: true with a typed card keeps it once the provider accepted it. Answers awaiting_otp with payment_id and phone_hint; a declined card is 200 with payment.status=failed; an unlisted/disabled method is 422 naming method."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.payment) {",
