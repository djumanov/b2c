# Copy to .env and fill in. Every variable the backend reads is declared here
# and, typed, in app/core/config.py. Never call os.getenv anywhere else.
#
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE HOLDS INFRASTRUCTURE ONLY.
#
# Anything a client could want different — branding, colours, languages,
# currencies, timezone, allowed CORS domains, GTS and payment credentials,
# SMTP settings — lives in the DATABASE and is edited from the admin panel,
# with no redeploy (PROJECT.md §7, ARCHITECTURE.md §1).
#
# Before adding a variable here, ask: "could two clients want different
# values?" If yes, it belongs in the database, not in this file.
#
# The two exceptions at the bottom — FIRST_OWNER_* and SMTP_* — are SEEDS, not
# settings. They are read on the first boot of an empty database and never
# again, because an installation with nothing in it has nobody to sign in and
# no way to mail the code that signing in needs. The moment the panel writes
# either one, the value below stops being consulted.
# ─────────────────────────────────────────────────────────────────────────────

# --- app ---
DEBUG=false
LOG_LEVEL=INFO
# Reported by GET /admin/system/version/ — the first thing asked for in support.
APP_VERSION=0.1.0

# Registers a fake payment adapter so /public/profile/cards/ can be exercised
# without a merchant account. It accepts any card the schema allows and confirms
# it with the code 111111, which it also writes to the log.
#   confirm with:  111111
#   a card it takes:      8600 4907 4466 4608
#   a card it declines:   8600 4900 0000 0000   (Luhn-valid, so it reaches the
#                                                adapter and comes back 400)
#
# ⚠  Development only. The backend refuses to start with this on unless
#    DEBUG=true — on a live server it would take real cards and wave them through.
#    Switch it on, then enable "payme" in the panel with any credentials.
PAYMENTS_DEMO_ADAPTER=false

# --- database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# ⚠  REPLACE THIS — the backend refuses to start on it unless DEBUG=true.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=b2c

# --- cache / broker (Redis) ---
# Used for: site-config cache, static catalogues, Idempotency-Key, the GTS
# session, rate-limit counters and the Celery broker. NOT for search results
# (ARCHITECTURE.md D2, §9).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- JWT signing ---
# Rotating this invalidates every issued access and refresh token.
#
# ⚠  REPLACE THIS. The value below is published in the source repository, so
#    leaving it means anybody can sign themselves an `owner` token. The backend
#    refuses to start on it unless DEBUG=true. At least 32 characters:
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- secret encryption (AES-GCM) ---
# Integration credentials are stored encrypted in the database. Each row keeps
# the key_version it was written with, so a key can be rotated without
# re-entering every credential (PROJECT.md §13).
#
# Format: comma-separated "version:base64-encoded-32-byte-key" pairs.
# Generate one with:  python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
# Version used to encrypt NEW values. Older versions stay listed above so
# existing rows remain readable.
ENCRYPTION_KEY_VERSION=1
#
# ⚠  BACK THIS KEY UP SEPARATELY FROM THE DATABASE DUMP.
#    Lose it and every integration credential must be re-entered by hand —
#    GTS and the payment providers stop working (PROJECT.md §14).

# --- first owner (used only on the very first boot, then ignored) ---
# ⚠  REPLACE THE PASSWORD — it is the account that owns the installation, and
#    the value below is published. The backend refuses to start on it unless
#    DEBUG=true.
FIRST_OWNER_EMAIL=owner@example.com
FIRST_OWNER_PASSWORD=change-me
FIRST_OWNER_NAME=Owner

# --- SMTP relay (used only on the very first boot, then ignored) ---
# Seeds /admin/integrations/notifications/ (API.md §29) on an installation
# whose SMTP row is still empty, and switches mail on. Afterwards the panel
# owns it: editing the lines below changes nothing on a configured
# installation, and re-running the bootstrap leaves it alone.
#
# Leave SMTP_HOST or SMTP_FROM empty to skip the seed entirely — mail then
# stays off and OTP codes go to the log until somebody configures the panel.
#
# Gmail wants an App Password here, not the account password.
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
